{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://freeshop.local/schemas/catalog.schema.json",
  "title": "FreeShop Catalog",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "apps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "apps": {
      "type": "array",
      "items": { "$ref": "#/definitions/appEntry" }
    }
  },
  "definitions": {
    "appEntry": {
      "type": "object",
      "required": [
        "id",
        "title",
        "author",
        "category",
        "description",
        "version",
        "iconUrl",
        "downloadUrl",
        "fileSize",
        "filename"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Stable unique slug, used as the folder key for downloads/icons and the SD card install folder."
        },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "maxLength": 200 },
        "longDescription": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "iconUrl": { "type": "string", "minLength": 1 },
        "downloadUrl": { "type": "string", "minLength": 1 },
        "fileSize": { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.(nro|nsp|xci)$",
          "description": "Filename of the downloaded artifact. Extension must match fileType (.nro for \"nro\", .nsp for \"nsp\", .xci for \"xci\")."
        },
        "fileType": {
          "type": "string",
          "enum": ["nro", "nsp", "xci"],
          "default": "nro",
          "description": "\"nro\": homebrew app, installed directly into sdmc:/switch/<id>/ and launched from hbmenu. \"nsp\"/\"xci\": installable title, handed off to DBI (https://github.com/rashevskyv/dbi) for NCM/ES installation since that requires CFW-level system services this project doesn't reimplement - DBI installs both formats the same way."
        },
        "homepageUrl": { "type": "string" },
        "license": { "type": "string" },
        "parentId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "If set, this entry is DLC/an update for the base game with this id - hidden from the main list/grid, shown instead in that game's detail screen. The target should itself have no parentId (one level of nesting only)."
        },
        "contentType": {
          "type": "string",
          "enum": ["dlc", "update"],
          "description": "Only meaningful when parentId is set - label shown for this entry in its parent's DLC/updates list."
        },
        "source": {
          "type": "object",
          "required": ["origin"],
          "properties": {
            "origin": { "type": "string", "enum": ["curated", "aggregated"] },
            "sourceIndex": { "type": "string" },
            "sourceId": { "type": "string" }
          },
          "additionalProperties": true
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
