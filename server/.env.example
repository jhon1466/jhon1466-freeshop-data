# Password required to log into /admin and to save the catalog.
ADMIN_PASSWORD=

# Fine-grained GitHub PAT scoped to the data repo, "Contents: Read and write".
# Used for both reads (via the Contents API, cached 30s server-side - see
# server/src/lib/catalog.ts) and saves. Without it, reads fall back to
# unauthenticated GitHub API calls (60 req/hour limit instead of 5000/hour).
GITHUB_TOKEN=

# Defaults shown below - override only if the data repo differs.
# GITHUB_OWNER=jhon1466
# GITHUB_REPO=jhon1466-freeshop-data
# GITHUB_BRANCH=main
# GITHUB_PATH=data/catalog.json

# PORT=8080
